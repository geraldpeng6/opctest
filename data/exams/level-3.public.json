    {
      "id": "q03",
      "type": "exact_text",
      "prompt": "将退款规则 v2 应用于客服案例接口，并回答唯一符合自动退款条件的案例编号。",
      "materials": [
        "/materials/policy/refund-v2",
        "/api/data/level-3/support-cases"
