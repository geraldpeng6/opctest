    {
      "id": "q10",
      "type": "exact_text",
      "prompt": "使用库存接口指南和分页库存移动接口。按文档公式累计最近 30 天净流出，并回答唯一触发红色补货的告警代码。",
      "materials": [
        "/materials/docs/inventory-api-v1",
        "/api/data/level-3/inventory-movements?cursor=start"
