    {
      "id": "q09",
      "type": "integer",
      "prompt": "使用水星发射简报、团队名册表和徽章映射接口。统计发射周徽章标记为“推进”且名册状态为“在岗”的工程人员数量。",
      "materials": [
        "/materials/archive/mercury-launch-brief",
        "/files/level-3/team-roster.csv",
        "/api/data/level-3/badge-map"
